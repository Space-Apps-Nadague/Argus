# ─────────────────────────────────────────────────────────────────────────────
# ARGUS AI backend (server/) — see specs/04-ai-backend.md
# Everything here is SERVER-SIDE ONLY. Never prefix AI keys with VITE_ (that ships them to browsers).
# With nothing configured, every AI endpoint serves the offline verified NASA HRP protocols.
# ─────────────────────────────────────────────────────────────────────────────

# Ordered fallback chain. Examples:
#   local                 → only your local model (free, works offline)
#   local,openrouter      → local first, free cloud model if local is down
#   openrouter,gemini     → cloud only
#   auto (default)        → every configured cloud provider, then local
AI_PROVIDERS=local,openrouter

# ── Local model (Ollama / LM Studio / any OpenAI-compatible local server) ────
# Ollama:    ollama pull qwen3:8b       (small)   |  qwen3.6 (big, 23 GB)
# LM Studio: AI_LOCAL_BASE_URL=http://localhost:1234/v1
AI_LOCAL_MODEL=qwen3.6
AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_VISION_MODEL=qwen2.5vl:7b
# Thinking models are slow; "none" or "low" makes them answer faster.
# AI_LOCAL_REASONING_EFFORT=none
# AI_LOCAL_TIMEOUT_MS=180000

# ── OpenRouter — free models, key at https://openrouter.ai/keys ─────────────
# Default model "openrouter/free" auto-routes to a free model (supports images + JSON).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free

# ── Google Gemini — free tier, key at https://aistudio.google.com/apikey ────
# (Also used by the PM agent below.) Only used by the AI backend when "gemini" or "auto" is in AI_PROVIDERS.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ── Groq — free tier, key at https://console.groq.com/keys ──────────────────
GROQ_API_KEY=
# GROQ_MODEL=           (required — pick a current model from Groq's console)

# ── Generic / custom endpoint (hosted agent gateway, vLLM, etc.) ────────────
# A bare AI_API_KEY is auto-detected by prefix: sk-or- → OpenRouter, AIza → Gemini, gsk_ → Groq.
# Set AI_BASE_URL + AI_MODEL to use any other OpenAI-compatible endpoint.
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ── Per-feature routing (optional) ──────────────────────────────────────────
# Features: GUIDANCE, VISION, DIAGNOSTICS, RECOMMENDATIONS, WELLBEING, CHAT
# AI_ROUTE_CHAT=local
# AI_ROUTE_DIAGNOSTICS=openrouter,local

# ── Server ──────────────────────────────────────────────────────────────────
# AI_TIMEOUT_MS=60000
# ARGUS_SERVER_PORT=8787
# ARGUS_CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Data platform — specs/05-data-platform.md, docs/DATABASE.md
# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE database:
#   Shared team DB (Azure):  postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/argus?sslmode=require
#   Docker:                  postgres://argus:argus@localhost:5432/argus     (docker compose up -d postgres)
#   Embedded, no install:    pglite:./.data/argus
# Unset = stateless mode: the HUD runs the offline demo data and AI routes need no login.
DATABASE_URL=pglite:./.data/argus
# First admin, created by `npm run db:seed` (password ≥ 10 chars). Or create it in the HUD on first run.
ARGUS_BOOTSTRAP_ADMIN_USERNAME=admin
ARGUS_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: demo logins valkyrie / apex / pulse / solaris (astronauts) and surgeon, all with this password.
ARGUS_DEMO_PASSWORD=
# Secret for wearable device tokens (scripts/simulate-wearables.ts and POST /api/ingest/readings).
ARGUS_DEVICE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Autonomous Product Manager (PM) Agent credentials (used by .github/workflows/pm-agent.yml or local CLI)
# GEMINI_API_KEY is shared with the AI backend section above.
PM_PROJECT_NUMBER=
# Optional: Org/user login owning the GitHub Project (defaults to repository owner)
PM_PROJECT_OWNER=
# Optional: Token with `project` scope if syncing a GitHub Projects v2 board from GitHub Actions
GH_PROJECT_TOKEN=
